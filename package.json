{
  "name": "@themochiapp/cli",
  "version": "0.1.0",
  "description": "Read-only Mochi Public API CLI for humans, scripts, and AI agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheMochiApp/mochi-cli.git"
  },
  "homepage": "https://github.com/TheMochiApp/mochi-cli#readme",
  "bugs": {
    "url": "https://github.com/TheMochiApp/mochi-cli/issues"
  },
  "keywords": [
    "mochi",
    "crm",
    "api",
    "oauth",
    "agent"
  ],
  "type": "module",
  "bin": {
    "mochi": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:skill": "node scripts/verify-skill.mjs",
    "verify:skill-install": "node scripts/install-skill-smoke.mjs",
    "check:live-docs": "node scripts/check-live-docs.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run verify:skill && npm test && npm run build"
  }
}
